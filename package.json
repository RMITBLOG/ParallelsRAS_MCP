{
  "name": "parallels-ras-mcp",
  "version": "1.3.0",
  "description": "MCP server for Parallels RAS REST API - read-only infrastructure monitoring (stdio + HTTP transports)",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "package:skill": "npm run build && node tools/package-skill.mjs",
    "test": "npm run package:skill && node --test",
    "start": "node build/index.js",
    "start:http": "MCP_TRANSPORT=http node build/index.js"
  },
  "author": "Ryan Mangan",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.17"
  },
  "engines": {
    "node": ">=18.14.1"
  }
}
